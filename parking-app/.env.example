GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# สุ่มค่าอย่างน้อย 32 ตัวอักษร และตั้งค่าเดียวกันใน Vercel Preview
SESSION_SECRET=replace-with-a-long-random-secret
# ใช้ยืนยัน Vercel Cron ที่สร้าง payment snapshot เวลา 00:05 (ตั้งค่าใน Vercel เช่นเดียวกับ SESSION_SECRET)
CRON_SECRET=replace-with-a-different-long-random-secret
